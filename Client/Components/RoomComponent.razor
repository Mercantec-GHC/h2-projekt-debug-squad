@using Shared

<div class="rooms-grid">
    @if (Rooms != null)
    {
        foreach (var room in Rooms)
        {
            <a href="/room-details/@room.Id">
                <div class="room-card">
                        <h4>@room.Number</h4>
                    <p>Room ID: @room.Id</p>
                    <p>Type: @room.RoomType.Name</p>
                    <p>Capacity: @room.RoomType.Capacity</p>
                    <p>Price per Night: $@room.RoomType.PricePerNight</p>

                   
                </div>
            </a>
        }
    }
    else
    {
        <p>No rooms available.</p>
    }
</div>

@code {
    [Parameter]
    public List<RoomDto> Rooms { get; set; }
}
