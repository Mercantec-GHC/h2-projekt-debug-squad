@using Shared
@inject HttpClient http

@page "/room-type-details/{Id:int}"

<h3>Room Type Details</h3>

@if (roomType != null)
{
    <div class="mb-3">
        <h4>@roomType.Name</h4>
        <p>Room Type ID: @roomType.Id</p>
        <p>Capacity: @roomType.Capacity</p>
        <p>Price per Night: $@roomType.PricePerNight</p>
    </div>
}
else
{
    <p>Loading room type details...</p>
}

<p class="text-danger">@message</p>

@code {
    [Parameter]
    public int Id { get; set; }

    private RoomTypeDto? roomType;
    private string message = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            // Fetch room type details
            roomType = await http.GetFromJsonAsync<RoomTypeDto>($"api/roomtypes/{Id}");
        }
        catch (Exception ex)
        {
            message = $"Error loading room type: {ex.Message}";
        }
    }
}