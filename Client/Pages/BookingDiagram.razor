@page "/diagram"
@inject HttpClient Http
@inject NavigationManager Navigation
@using Shared

<h3 class="mb-4">Booking Diagram</h3>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert alert-info">@_message</div>
}

@if (roomTypes.Any())
{
    foreach (RoomTypeDto roomType in roomTypes)
    {
        <h4>@roomType.Name</h4>

        <div class="table-responsive">
            <table class="table table-bordered text-center align-middle">
                <thead>
                    <tr>
                        <th>Room</th>
                        @foreach (var day in GetDays())
                        {
                            <th>@day.DayOfWeek.ToString().Substring(0, 3)  @day.ToString("dd-MM")</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (RoomDto room in roomType.Rooms)
                    {
                            <tr>
                            <td class="fw-bold">@room.Number</td>
                            @foreach (var day in GetDays())
                            {
                                <th></th>
                            }
                            </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}


@code {
    List<BookingDto> bookings = new();
    List<RoomTypeDto> roomTypes = new();
    string _message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadBookings();
        await LoadRoomTypes();
    }

    private async Task LoadBookings()
    {
        try
        {
            bookings = await Http.GetFromJsonAsync<List<BookingDto>>("api/bookings") ?? new List<BookingDto>();
            bookings = bookings.OrderBy(b => b.Id).ToList();
        }
        catch (Exception ex)
        {
            _message = $"Error loading bookings: {ex.Message}";
        }
    }

    private async Task LoadRoomTypes()
    {
        try
        {
            roomTypes = await Http.GetFromJsonAsync<List<RoomTypeDto>>("api/roomtypes/include") ?? new List<RoomTypeDto>();
        }
        catch (Exception ex)
        {
            _message = $"Error loading room types: {ex.Message}";
        }
    }

    private List<DateTime> GetDays()
    {
        var start = DateTime.Today;
        var end = DateTime.Today.AddDays(6);

        var days = new List<DateTime>();

        for (var time = start; time <= end; time = time.AddDays(1))
        {
            days.Add(time);
        }

        return days;
    }
}