@page "/booking/{RoomTypeId:int}"
@page "/booking/{RoomTypeId:int}/{CheckIn:datetime}/{CheckOut:datetime}"
@using Shared
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Booking Page</h3>

@if (SelectedRoomType != null && !Step1Completed) //if roomType is selected and step1 is not completed show the block
{
    <!-- Step 1: Dates are pre-filled and read-only, only guests count editable -->
    <h4>Step 1: Confirm Guests</h4>

    <p><strong>RoomType:</strong> @SelectedRoomType?.Name</p>
    <p><strong>Price per night:</strong> $@SelectedRoomType?.PricePerNight</p>

    <p><strong>Check-in:</strong> @CheckInDate.ToShortDateString()</p>
    <p><strong>Check-out:</strong> @CheckOutDate.ToShortDateString()</p>

    <label>Number of Guests:</label>
    <input type="number"
           @bind="SelectedCapacity"
           min="1"
           max="@SelectedRoomType?.Capacity"
           class="form-control mb-2" />

    <button class="btn btn-primary w-100" @onclick="NextStep">Next</button>

    @if (!string.IsNullOrEmpty(Message))
    {
        <div class="alert alert-danger mt-2">@Message</div>
    }
}
else if (!GuestExists)
{
    <!-- Step 2: Enter Guest Email -->
    <h4>Step 2: Guest Info Required</h4>
    <input type="email" @bind="GuestEmail" placeholder="Enter your email" class="form-control mb-2" />

    <button class="btn btn-success w-100" @onclick="CheckGuest" disabled="@string.IsNullOrWhiteSpace(GuestEmail)">
        Next
    </button>

    @if (!string.IsNullOrEmpty(Message))
    {
        <div class="alert alert-danger mt-2">@Message</div>
    }
}
else
{
    <!-- Step 3: Confirm Booking -->
    <h4>Step 3: Confirm Booking</h4>

    <p><strong>RoomType:</strong> @SelectedRoomType?.Name</p>
    <p><strong>Check-in:</strong> @CheckInDate.ToShortDateString()</p>
    <p><strong>Check-out:</strong> @CheckOutDate.ToShortDateString()</p>
    <p><strong>Nights:</strong> @NumberOfNights</p>
    <p><strong>Guests:</strong> @SelectedCapacity</p>
    <p><strong>Price per night:</strong> $@SelectedRoomType?.PricePerNight</p>
    <p><strong>Total Price:</strong> $@TotalPrice</p>

    <button class="btn btn-primary w-100" @onclick="FinishBooking">Confirm Booking</button>

    @if (!string.IsNullOrEmpty(Message))
    {
        <div class="alert alert-success mt-2">@Message</div>
    }
}

@code {
    [Parameter] public int RoomTypeId { get; set; }  // parameters from URL
    [Parameter] public DateTime? CheckIn { get; set; }
    [Parameter] public DateTime? CheckOut { get; set; }

    private RoomTypeDto? SelectedRoomType;
    private DateTime CheckInDate;
    private DateTime CheckOutDate;
    private int SelectedCapacity = 1;

    private bool Step1Completed = false;
    private bool GuestExists = false;
    private int GuestId;
    private string GuestEmail = string.Empty;
    private string Message = string.Empty;

    private int NumberOfNights => (CheckOutDate - CheckInDate).Days;
    private decimal TotalPrice => SelectedRoomType != null ? SelectedRoomType.PricePerNight * NumberOfNights : 0;

    protected override async Task OnInitializedAsync()
    {
        // Load the roomType
        var roomTypeList = await Http.GetFromJsonAsync<List<RoomTypeDto>>("api/roomtypes");
        SelectedRoomType = roomTypeList?.FirstOrDefault(r => r.Id == RoomTypeId);

        if (SelectedRoomType == null)
        {
            Message = "RoomType not found";
            return;
        }

        // Prefill dates from URL or defaults
        CheckInDate = CheckIn?.Date ?? DateTime.Today;
        CheckOutDate = CheckOut?.Date ?? DateTime.Today.AddDays(1);
    }

    private void NextStep()
    {
        if (SelectedCapacity < 1)
        {
            Message = "Please enter a valid number of guests";
            return;
        }

        if (SelectedRoomType != null && SelectedCapacity > SelectedRoomType.Capacity)
        {
            Message = $"Maximum capacity for this roomType is {SelectedRoomType.Capacity} guests.";
            return;
        }

        Step1Completed = true;
        Message = string.Empty;
    }

    private async Task CheckGuest()
    {
        if (string.IsNullOrWhiteSpace(GuestEmail))
        {
            Message = "Please enter your email";
            return;
        }

        try
        {
            var guest = await Http.GetFromJsonAsync<GuestDto>($"api/guests/byemail?email={Uri.EscapeDataString(GuestEmail)}");
            //check if a guest exist by email
            if (guest == null)
            {
                Navigation.NavigateTo("/signup"); //if not navigates to sign up
                return;
            }

            GuestId = guest.Id;
            GuestExists = true;
            Message = string.Empty;
        }
        catch
        {
            Navigation.NavigateTo("/signup");  //// if any error occurs, navigate to sign up page
        }
    }

    private async Task FinishBooking()
    {
        if (SelectedRoomType == null) return;

        var bookingForm = new CreateBookingCommand(GuestId, SelectedRoomType.Id, CheckInDate.Date, CheckOutDate.Date);

        try
        {
            var response = await Http.PostAsJsonAsync("api/bookings", bookingForm); //sends booking too the server

            if (response.IsSuccessStatusCode)
            {
                Message = "Booking completed successfully!";
                Step1Completed = false;
                GuestExists = false;
                GuestEmail = string.Empty;
                SelectedCapacity = 1;

                await Task.Delay(3000);
                Navigation.NavigateTo("/");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Message = $"Error: {error}";
            }
        }
        catch (Exception ex)
        {
            Message = $"Something went wrong: {ex.Message}";
        }
    }
}
