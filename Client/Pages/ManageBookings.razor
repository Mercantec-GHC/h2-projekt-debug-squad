@page "/manage/bookings"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime
@using Shared
@using Shared.Commands.Booking

<h3 class="mb-4 d-flex justify-content-between align-items-center">
    <span>
        <i class="bi bi-people-fill me-2 text-secondary"></i>
        Manage Bookings
    </span>

    <button class="btn btn-success" @onclick="GoToDiagram">
        Go to Diagram
    </button>
</h3>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert alert-info">@_message</div>
}

@if (bookings != null && bookings.Any())
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Room Number</th>
                <th>Guest</th>
                <th>Room Type</th>
                <th>Check-In</th>
                <th>Check-Out</th>
                <th>Total Price</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in bookings)
            {
                <tr>
                    <td>@booking.Room?.Number</td>
                    <td>@booking.GuestName</td>
                    <td>@(booking.RoomType?.Name ?? "N/A")</td>
                    <td>@booking.CheckInDate.ToShortDateString()</td>
                    <td>@booking.CheckOutDate.ToShortDateString()</td>
                    <td>$@booking.TotalPrice</td>
                    <td>
                        <button class="btn btn-sm btn-primary" @onclick="() => AssignRoom(booking.Id)">
                            Assign Room
                        </button>
                        <button class="btn btn-sm btn-danger" @onclick="() => CancelBooking(booking.Id, booking.GuestId)">
                            Cancel
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">No bookings available.</p>
}

@code {
    private List<BookingSummaryDto> bookings = new();
    private string _message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadBookings();
    }

    private async Task LoadBookings()
    {
        try
        {
            bookings = await Http.GetFromJsonAsync<List<BookingSummaryDto>>("api/bookings/summary") ?? new List<BookingSummaryDto>();
        }
        catch (Exception ex)
        {
            _message = $"Error loading bookings: {ex.Message}";
        }
    }

    private async Task CancelBooking(int bookingId, int guestId)
    {
        bool confirmed = await JsRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to cancel this booking?");
        if (!confirmed) return;

        try
        {
            var command = new DeleteBookingCommand (guestId, bookingId);

            var request = new HttpRequestMessage(HttpMethod.Delete, "api/bookings")
            {
                Content = JsonContent.Create(command)   
            };

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                _message = "Booking cancelled successfully!";
                await LoadBookings();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                _message = $"Failed to cancel booking: {error}";
            }
        }
        catch (Exception ex)
        {
            _message = $"Error: {ex.Message}";
        }
    }

    private async Task AssignRoom(int bookingId)
    {
        try
        {
            var booking = bookings.FirstOrDefault(b => b.Id == bookingId);
            if (booking == null)
            {
                _message = "Booking not found.";
                return;
            }

            if (booking.RoomType == null)
            {
                _message = "Cannot assign room: booking has no Room Type information.";
                return;
            }

            // Send BookingId and RoomTypeId to let the server pick an available room
            var command = new AssignRoomCommand { BookingId = bookingId, RoomTypeId = booking.RoomType.Id };

            var response = await Http.PostAsJsonAsync("api/bookings/assign-room", command);

            if (response.IsSuccessStatusCode)
            {
                _message = "Room assigned successfully!";
                await LoadBookings(); // Refresh the bookings list
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                _message = $"Failed to assign room: {error}";
            }
        }
        catch (Exception ex)
        {
            _message = $"Error: {ex.Message}";
        }
    }

    private void GoToDiagram()
    {
        Navigation.NavigateTo("/diagram");
    }
}