@page "/manage/bookings"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime
@using Shared
@using Shared.Commands.Booking

<h3 class="mb-4 d-flex justify-content-between align-items-center">
    <span>
        <i class="bi bi-people-fill me-2 text-secondary"></i>
        Manage Bookings
    </span>

    <button class="btn btn-success" @onclick="GoToDiagram">
        Go to Diagram
    </button>
</h3>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert alert-success">@_message</div>
}

@if (bookings != null && bookings.Any())
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Room Number</th>
                <th>Guest</th>
                <th>Room Type</th>
                <th>Check-In</th>
                <th>Check-Out</th>
                <th>Total Price</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in bookings)
            {
                <tr>
                    <td>@booking.Room?.Number</td>
                    <td>@booking.GuestName</td>
                    <td>@(booking.RoomType?.Name ?? "N/A")</td>
                    <td>@booking.CheckInDate.ToShortDateString()</td>
                    <td>@booking.CheckOutDate.ToShortDateString()</td>
                    <td>$@booking.TotalPrice</td>
                    <td>
                        @if (booking.Room == null)
                        {
                            <button class="btn btn-sm btn-primary me-2 " @onclick="() => AssignRoom(booking.Id)">Assign Room</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-warning me-2" @onclick="() => ReassignRoom(booking.Id)">Reassign Room</button>
                        }
                        <button class="btn btn-sm btn-danger" @onclick="() => CancelBooking(booking.Id, booking.GuestId)">Cancel</button>
             
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">No bookings available.</p>
}

@code {
    private List<BookingSummaryDto> bookings = new();
    private string _message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadBookings();
    }

    private async Task LoadBookings()
    {
        try
        {
            bookings = await Http.GetFromJsonAsync<List<BookingSummaryDto>>("api/bookings/summary")
                ?? new List<BookingSummaryDto>();
        }
        catch (Exception ex)
        {
            ShowMessage($"Error loading bookings: {ex.Message}");
        }
    }

    private async Task CancelBooking(int bookingId, int guestId)
    {
        bool confirmed = await JsRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to cancel this booking?");
        if (!confirmed) return;

        try
        {
            var command = new DeleteBookingCommand(guestId, bookingId);

            var request = new HttpRequestMessage(HttpMethod.Delete, "api/bookings")
            {
                Content = JsonContent.Create(command)
            };

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                ShowMessage("Booking cancelled successfully!");
                await LoadBookings();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ShowMessage($"Failed to cancel booking: {error}");
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"Error: {ex.Message}");
        }
    }

    private async Task AssignRoom(int bookingId)
    {
        try
        {
            var booking = bookings.FirstOrDefault(b => b.Id == bookingId);
            if (booking == null)
            {
                ShowMessage("Booking not found.");
                return;
            }

            if (booking.RoomType == null)
            {
                ShowMessage("Cannot assign room: booking has no Room Type information.");
                return;
            }

            var command = new AssignRoomCommand(bookingId, booking.RoomType.Id);

            var response = await Http.PostAsJsonAsync("api/bookings/assign-room", command);

            if (response.IsSuccessStatusCode)
            {
                ShowMessage("Room assigned successfully!");
                await LoadBookings();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ShowMessage($"Failed to assign room: {error}");
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"Error: {ex.Message}");
        }
    }

    private void GoToDiagram()
    {
        Navigation.NavigateTo("/diagram");
    }

    private void ShowMessage(string message)
    {
        _message = message;
        StateHasChanged();

        _ = ClearMessageAfterDelay();
    }

    private async Task ClearMessageAfterDelay()
    {
        await Task.Delay(3000);
        _message = string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ReassignRoom(int bookingId)
{
    bool confirmed = await JsRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to reassign this room?");
    if (!confirmed) return;

    try
    {
        var booking = bookings.FirstOrDefault(b => b.Id == bookingId);
        if (booking == null || booking.RoomType == null)
        {
            ShowMessage("Cannot reassign: Booking not found or has no Room Type.");
            return;
        }

        var command = new ReassignRoomCommand
        {
            BookingId = bookingId,
            RoomTypeId = booking.RoomType.Id
        };

        var response = await Http.PostAsJsonAsync("api/bookings/reassign-room", command);

        if (response.IsSuccessStatusCode)
        {
            ShowMessage("Room reassigned successfully!");
            await LoadBookings();
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            ShowMessage($"Failed to reassign room: {error}");
        }
    }
    catch (Exception ex)
    {
        ShowMessage($"Error: {ex.Message}");
    }
}
}