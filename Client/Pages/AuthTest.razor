@page "/auth-test"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject Client.Auth.JwtAuthenticationStateProvider AuthStateProvider
@inject Microsoft.JSInterop.IJSRuntime JS
@using Shared

<h3>Authentication Test</h3>

<!-- Section 1: Auth State -->
<div class="card p-4 shadow-sm mb-4">
    <h5>1. Authentication State</h5>
    <AuthorizeView>
        <Authorized>
            <div class="alert alert-success">
                <strong>Authenticated</strong> as <em>@context.User.Identity?.Name</em>
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="alert alert-warning">
                <strong>Not authenticated</strong> — <a href="/login">Go to Login</a>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

<!-- Section 2: JWT Claims -->
<div class="card p-4 shadow-sm mb-4">
    <h5>2. JWT Claims</h5>
    @if (_claims.Any())
    {
        <table class="table table-sm table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Claim Type</th>
                    <th>Value</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var claim in _claims)
                {
                    <tr>
                        <td><code>@claim.Type</code></td>
                        <td>@claim.Value</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">No claims available. Log in first.</p>
    }
</div>

<!-- Section 3: Token Info -->
<div class="card p-4 shadow-sm mb-4">
    <h5>3. Token in localStorage</h5>
    @if (!string.IsNullOrEmpty(_rawToken))
    {
        <div class="alert alert-info" style="word-break: break-all; font-size: 0.8rem;">
            @_rawToken
        </div>
    }
    else
    {
        <p class="text-muted">No token stored.</p>
    }
</div>

<!-- Section 4: API Call Test -->
<div class="card p-4 shadow-sm mb-4">
    <h5>4. API Call Test</h5>
    <p class="text-muted">Calls <code>GET api/guests</code> with the current Authorization header.</p>
    <button class="btn btn-outline-success btn-sm" @onclick="TestApiCall">Test API Call</button>
    @if (!string.IsNullOrEmpty(_apiResult))
    {
        <div class="alert @_apiAlertClass mt-3" style="word-break: break-all; font-size: 0.85rem;">
            @_apiResult
        </div>
    }
</div>

<!-- Section 5: Quick Login / Logout -->
<div class="card p-4 shadow-sm mb-4">
    <h5>5. Quick Login / Logout</h5>
    <div class="d-flex gap-2 align-items-end">
        <div>
            <label class="form-label">Email</label>
            <input type="email" class="form-control" @bind="_testEmail" placeholder="Enter guest email" />
        </div>
        <button class="btn btn-primary" @onclick="QuickLogin">Login</button>
        <button class="btn btn-danger" @onclick="QuickLogout">Logout</button>
    </div>
    @if (!string.IsNullOrEmpty(_loginMessage))
    {
        <div class="alert @_loginAlertClass mt-3">@_loginMessage</div>
    }
</div>

@code {
    private List<ClaimInfo> _claims = new();
    private string _rawToken = string.Empty;
    private string _apiResult = string.Empty;
    private string _apiAlertClass = "alert-info";
    private string _testEmail = string.Empty;
    private string _loginMessage = string.Empty;
    private string _loginAlertClass = "alert-info";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadClaims();
            await LoadToken();
            StateHasChanged();
        }
    }

    private async Task LoadClaims()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _claims = authState.User.Claims
            .Select(c => new ClaimInfo(c.Type, c.Value))
            .ToList();
    }

    private async Task LoadToken()
    {
        _rawToken = await JS.InvokeAsync<string?>("localStorage.getItem", "authToken") ?? string.Empty;
    }

    private async Task TestApiCall()
    {
        try
        {
            var response = await Http.GetAsync("api/guests");
            var content = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                _apiAlertClass = "alert-success";
                _apiResult = $"Status {(int)response.StatusCode} OK — Response: {(content.Length > 300 ? content[..300] + "..." : content)}";
            }
            else
            {
                _apiAlertClass = "alert-danger";
                _apiResult = $"Status {(int)response.StatusCode} — {content}";
            }
        }
        catch (Exception ex)
        {
            _apiAlertClass = "alert-danger";
            _apiResult = $"Error: {ex.Message}";
        }
    }

    private async Task QuickLogin()
    {
        _loginMessage = string.Empty;
        try
        {
            var command = new LoginCommand(_testEmail);
            var response = await Http.PostAsJsonAsync("api/auth/login", command);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LoginResponseDto>();
                if (result != null)
                {
                    await AuthStateProvider.LoginAsync(result.Token);
                    _loginAlertClass = "alert-success";
                    _loginMessage = $"Logged in as {result.FullName}";
                    await LoadClaims();
                    await LoadToken();
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                _loginAlertClass = "alert-danger";
                _loginMessage = error;
            }
        }
        catch (Exception ex)
        {
            _loginAlertClass = "alert-danger";
            _loginMessage = $"Error: {ex.Message}";
        }
    }

    private async Task QuickLogout()
    {
        await AuthStateProvider.LogoutAsync();
        _claims = new();
        _rawToken = string.Empty;
        _apiResult = string.Empty;
        _loginAlertClass = "alert-info";
        _loginMessage = "Logged out.";
    }

    private record ClaimInfo(string Type, string Value);
}
