@page "/"
@inject HttpClient Http
@inject NavigationManager Navigation
@using Shared

<!-- Hero Section -->
<div class="hero text-center py-5 bg-beige">
    <h1 class="display-3 text-gold">Grand Horizon</h1>
    <p class="lead">Experience luxury like never before</p>
</div>

<!-- RoomType Filters -->
<div class="filters mt-4 mb-3 d-flex gap-3 justify-content-center flex-wrap">
    <input type="date" @bind="CheckInDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control w-auto" />
    <input type="date" @bind="CheckOutDate" min="@CheckInDate.AddDays(1).ToString("yyyy-MM-dd")" class="form-control w-auto" />

    <input type="number" placeholder="Capacity" @bind="_filterCapacity" class="form-control w-auto" />
    <input type="number" placeholder="Max Price" @bind="_filterMaxPrice" class="form-control w-auto" />
    <button class="btn btn-primary" @onclick="ApplyFilters">Search</button>
</div>

<!-- RoomType List -->
<div class="room-list container mt-4">
    @if (filteredRoomTypes != null && filteredRoomTypes.Any())
    {
        <div class="row">
            @foreach (var roomType in filteredRoomTypes)
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h5 class="card-text">@roomType.Name</h5>
                            <p class="card-text">Capacity: @roomType.Capacity</p>
                            <p class="card-text">Price per night: $@roomType.PricePerNight</p>

                            <button class="btn btn-outline-primary w-100 mb-2"
                                    @onclick="() => ViewRoomDetails(roomType.Id)">
                                Read More
                            </button>

                            <button class="btn btn-success w-100"
                                    @onclick="() => BookRoom(roomType.Id)">
                                Book Now
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-center text-muted">No rooms available.</p>
    }
</div>

@code {
    private List<RoomTypeDto> roomTypes = new();
    private List<RoomTypeDto> filteredRoomTypes = new();

    private int? _filterCapacity;
    private decimal? _filterMaxPrice;

    private DateTime CheckInDate = DateTime.Today;
    private DateTime CheckOutDate = DateTime.Today.AddDays(1);

    protected override async Task OnInitializedAsync()
    {
        await LoadAllRooms();
    }

    private async Task LoadAllRooms()
    {
        roomTypes = await Http.GetFromJsonAsync<List<RoomTypeDto>>("api/roomtypes") ?? new List<RoomTypeDto>();

        filteredRoomTypes = new List<RoomTypeDto>(roomTypes);
    }

    private async Task ApplyFilters()
    {
        var request = new GetAvailableRoomTypesCommand(CheckInDate.Date, CheckOutDate.Date, _filterCapacity, _filterMaxPrice);
            
        var response = await Http.PostAsJsonAsync("api/roomtypes/available", request);

        if (response.IsSuccessStatusCode)
        {
            filteredRoomTypes = await response.Content.ReadFromJsonAsync<List<RoomTypeDto>>() ?? new List<RoomTypeDto>();
        }
        else
        {
            filteredRoomTypes = new List<RoomTypeDto>();
        }
    }

    private void ViewRoomDetails(int roomTypeId)
    {
        Navigation.NavigateTo($"/room-type-details/{roomTypeId}");
    }

    private void BookRoom(int roomTypeId)
    {
        Navigation.NavigateTo($"/booking/{roomTypeId}/{CheckInDate:yyyy-MM-dd}/{CheckOutDate:yyyy-MM-dd}");
    }
}
