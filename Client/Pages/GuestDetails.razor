@page "/guest-details/{GuestId:int}"
@using Client.Models
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime

<h3>Guest Details</h3>

@if (guest == null)
{
    <p>Loading...</p>
}
else
{
    <!-- Guest Info -->
    <div class="card p-3 mb-3 shadow-sm">
        <p><strong>Guest ID:</strong> @guest.Id</p>
        <p><strong>Full Name:</strong> @guest.FullName</p>
        <p><strong>Email:</strong> @guest.Email</p>
        <p><strong>Phone Number:</strong> @guest.PhoneNumber</p>
    </div>

    <!-- Booking History -->
    <h4>Booking History</h4>
    @if (guest.Bookings != null && guest.Bookings.Count > 0)
    {
        <div class="row g-3">
            @foreach (var booking in guest.Bookings)
            {
                <div class="col-md-4">
                    <div class="card p-3 shadow-sm">
                        <p><strong>Room:</strong> @booking.Room.Number</p>
                        <p><strong>Capacity:</strong> @booking.Room.Capacity</p>
                        <p><strong>Price per Night:</strong> $@booking.Room.PricePerNight</p>
                        <p><strong>Check-in:</strong> @booking.CheckInDate.ToShortDateString()</p>
                        <p><strong>Check-out:</strong> @booking.CheckOutDate.ToShortDateString()</p>

                        <!-- Optional: Book Again Button -->
                        <button class="btn btn-success w-100 mt-2" @onclick="() => NavigateToBooking(booking.Room.Id)">
                            Book Again
                        </button>

                        <!-- Cancel Booking Button -->
                        <button class="btn btn-danger w-100 mt-2" @onclick="() => CancelBooking(booking.Id)">
                            <i class="bi bi-x-circle me-1"></i> Cancel Booking
                        </button>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p>This guest has no bookings.</p>
    }
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success mt-2">@successMessage</div>
}

<p class="text-danger">@message</p>

@code {
    [Parameter] public int GuestId { get; set; }

    private GuestDto? guest;
    private string message = string.Empty;
    private string successMessage = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            guest = await Http.GetFromJsonAsync<GuestDto>($"api/guests/{GuestId}");
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
        }
    }

    private void NavigateToBooking(int roomId)
    {
        Navigation.NavigateTo($"/booking/{roomId}");
    }

    private async Task CancelBooking(int bookingId)
    {
        bool confirmed = await JsRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to cancel this booking?");
        if (!confirmed) return;

        try
        {
            var command = new { GuestId, BookingId = bookingId };

            var request = new HttpRequestMessage(HttpMethod.Delete, "api/bookings")
            {
                Content = JsonContent.Create(command)
            };

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                successMessage = "Booking cancelled successfully!";
                message = string.Empty;
                // Reload guest data to refresh the booking list
                guest = await Http.GetFromJsonAsync<GuestDto>($"api/guests/{GuestId}");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                message = $"Failed to cancel booking: {error}";
            }
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
        }
    }
}
