@page "/manage/rooms/edit/{Id:int}"
@inject HttpClient Http
@inject NavigationManager Nav
@using Shared

<h3>Edit Room</h3>

@if (_room == null || _roomTypes == null)
{
    <p>Loading...</p>
}
else
{
    <div class="card p-4 shadow-sm">

        <!-- Room Number (read-only) -->
        <div class="mb-3">
            <label class="form-label">Room Number</label>
            <input class="form-control" value="@_room.Number" disabled />
        </div>

        <!-- Room Type Dropdown -->
        <div class="mb-3">
            <label class="form-label">Room Type</label>
            <select class="form-select" @bind="SelectedRoomTypeId">
                @foreach (var type in _roomTypes)
                {
                    <option value="@type.Id">@type.Name</option>
                }
            </select>
        </div>

        <!-- Capacity (read-only) -->
        <div class="mb-3">
            <label class="form-label">Capacity</label>
            <input class="form-control" value="@_selectedRoomType?.Capacity" disabled />
        </div>

        <!-- Price per Night (read-only) -->
        <div class="mb-3">
            <label class="form-label">Price per night</label>
            <input class="form-control" value="@_selectedRoomType?.PricePerNight.ToString("F2")" disabled />
        </div>

        <!-- Save & Cancel buttons -->
        <button class="btn btn-warning w-100" @onclick="Save">Save</button>
        <button class="btn btn-secondary w-100 mt-2" @onclick="Cancel">Cancel</button>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private RoomDto? _room;
    private List<RoomTypeDto>? _roomTypes;
    private RoomTypeDto? _selectedRoomType;

    // Use a property with a setter to update _selectedRoomType dynamically
    private int SelectedRoomTypeId
    {
        get => _selectedRoomType?.Id ?? 0;
        set
        {
            if (_selectedRoomType?.Id != value)
            {
                _selectedRoomType = _roomTypes?.FirstOrDefault(x => x.Id == value);
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Load the room
        _room = await Http.GetFromJsonAsync<RoomDto>($"api/rooms/{Id}");

        // Load all room types
        _roomTypes = await Http.GetFromJsonAsync<List<RoomTypeDto>>("api/roomtypes");

        // Prefill dropdown with current room type
        if (_room != null)
        {
            _selectedRoomType = _room.RoomType;
        }
    }

    private async Task Save()
    {
        if (_room == null) return;

        var updateDto = new EditRoomCommand
        {
            RoomId = _room.Id,
            RoomTypeId = SelectedRoomTypeId // use the property bound to the dropdown
        };

        var response = await Http.PostAsJsonAsync("api/rooms/edit", updateDto);

        if (response.IsSuccessStatusCode)
        {
            Nav.NavigateTo("/manage/rooms");
        }
    }

    private void Cancel()
    {
        Nav.NavigateTo("/manage/rooms");
    }
}