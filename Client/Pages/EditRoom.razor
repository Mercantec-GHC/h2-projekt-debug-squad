@page "/manage/rooms/edit/{Id:int}"
@inject HttpClient Http
@inject NavigationManager Nav
@using Shared

<h3>Edit Room</h3>

@if (_room == null)
{
    <p>Loading...</p>
}
else
{
    <div class="card p-4 shadow-sm">
        <div class="mb-3">
            <label class="form-label">Room number</label>
            <input class="form-control" value="@_room.Number" disabled />
        </div>

        <div class="mb-3">
            <label class="form-label">Room Type</label>
            <input class="form-control" value="@_room.RoomType.Name" disabled />
        </div>

        <div class="mb-3">
            <label class="form-label">Capacity</label>
            <input class="form-control" type="number" @bind="_room.RoomType.Capacity" />
        </div>

        <div class="mb-3">
            <label class="form-label">Price per night</label>
            <input class="form-control" type="number" step="0.01" @bind="_room.RoomType.PricePerNight" />
        </div>

        <p class="text-muted small">Note: Editing capacity and price will affect all rooms of this type.</p>

        <button class="btn btn-warning w-100" @onclick="Save">
            Save
        </button>

        <button class="btn btn-secondary w-100 mt-2" @onclick="Cancel">
            Cancel
        </button>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private RoomDto? _room;

    protected override async Task OnInitializedAsync()
    {
        _room = await Http.GetFromJsonAsync<RoomDto>($"api/rooms/{Id}");
    }

    private async Task Save()
    {
        var response = await Http.PostAsJsonAsync($"api/rooms/edit", _room);

        if (response.IsSuccessStatusCode)
        {
            Nav.NavigateTo("/manage/rooms");
        }
    }

    private void Cancel()
    {
        Nav.NavigateTo("/manage/rooms");
    }
}
